<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.canvas.Canvas?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.HBox?>

<AnchorPane xmlns="http://javafx.com/javafx/8.0.171"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.pacmanfinal.gui.GameGUI"
            fx:id="rootPane"
            style="-fx-background-color: black;"
            prefWidth="560" prefHeight="620">

    <Canvas fx:id="gameCanvas"
            AnchorPane.topAnchor="0"
            AnchorPane.bottomAnchor="40"
            AnchorPane.leftAnchor="0"
            AnchorPane.rightAnchor="0"/>

    <HBox fx:id="uiPanel" alignment="CENTER_LEFT" spacing="20"
          style="-fx-background-color: rgba(0,0,0,0.7); -fx-padding: 5;"
          prefHeight="40"
          AnchorPane.bottomAnchor="0"
          AnchorPane.leftAnchor="0"
          AnchorPane.rightAnchor="0">
        <Label fx:id="scoreLabel" text="Score: 0"
               style="-fx-text-fill: white; -fx-font-size: 14;"/>
        <Label fx:id="livesLabel" text="Lives: 3"
               style="-fx-text-fill: white; -fx-font-size: 14;"/>
    </HBox>

    <StackPane fx:id="messagePane" alignment="CENTER"
               AnchorPane.topAnchor="0"
               AnchorPane.bottomAnchor="40"
               AnchorPane.leftAnchor="0"
               AnchorPane.rightAnchor="0">
        <Label fx:id="gameOverLabel"
               text="GAME OVER!"
               style="-fx-text-fill: red; -fx-font-size: 36; -fx-font-weight: bold;"
               visible="false"/>
        <Label fx:id="winLabel"
               text="YOU WIN!"
               style="-fx-text-fill: green; -fx-font-size: 36; -fx-font-weight: bold;"
               visible="false"/>
    </StackPane>
</AnchorPane>